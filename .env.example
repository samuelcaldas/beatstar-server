# Beatstar Private Server - Configurações de Ambiente

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_ENVIRONMENT=development
DEBUG=true

# Fuso Horário e Localização
TZ=America/Sao_Paulo
GENERIC_TIMEZONE=America/Sao_Paulo

# Banco de Dados
DATABASE_URL=sqlite+aiosqlite:///./data/beatstar.db

# Domínios e Gateway
GATEWAY_PUBLIC_HOST=beatstar.dev.timoteo.mg.gov.br
GATEWAY_PUBLIC_PORT=8080
GATEWAY_USE_SSL=false
ASSETS_BASE_URL=http://beatstar.dev.timoteo.mg.gov.br:8080/assets

# Autenticação e Segurança
JWT_SECRET_KEY=change-me-in-production-beatstar-secret-key-32chars
SESSION_EXPIRATION_HOURS=24
