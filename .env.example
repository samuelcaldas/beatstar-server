# Beatstar Private Server - Configurações de Ambiente

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_ENVIRONMENT=development
DEBUG=true

# Fuso Horário e Localização
TZ=America/Sao_Paulo
GENERIC_TIMEZONE=America/Sao_Paulo

# Banco de Dados
DATABASE_URL=sqlite+aiosqlite:///./data/beatstar.db

# Domínios e Gateway
GATEWAY_PUBLIC_HOST=beatstar.dev.timoteo.mg.gov.br
GATEWAY_PUBLIC_PORT=8080
GATEWAY_USE_SSL=false
ASSETS_BASE_URL=http://beatstar.dev.timoteo.mg.gov.br:8080/assets

# Autenticação e Segurança
JWT_SECRET_KEY=change-me-in-production-beatstar-secret-key-32chars
SESSION_EXPIRATION_HOURS=24

# Monetização e Google Ads (Feature Flag)
FEATURE_FLAG_GOOGLE_ADS_ENABLED=false
GOOGLE_ADS_APP_ID=ca-app-pub-3940256099942544~3347511713
GOOGLE_ADS_REWARDED_UNIT_ID=ca-app-pub-3940256099942544/5224354917
GOOGLE_ADS_INTERSTITIAL_UNIT_ID=ca-app-pub-3940256099942544/1033173712

# Feature Flags de Compras e Economia (Commerce SDK)
FEATURE_FLAG_IAP_ENABLED=false
FEATURE_FLAG_SHOP_ENABLED=true
FEATURE_FLAG_LOOTBOXES_ENABLED=true
FEATURE_FLAG_PREMIUM_PASS_ENABLED=true
FEATURE_FLAG_COSMETICS_ENABLED=true

# Administração (/api/admin). Sem ADMIN_AUTH_SECRET as rotas não são montadas.
# Gere um segredo com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use no mínimo 32 caracteres. Mantenha-o fora do Git (variável de ambiente ou arquivo montado).
# ADMIN_AUTH_SECRET=
ADMIN_SESSION_LIFETIME_SECONDS=28800
# Deixe true atrás de HTTPS; use false somente em desenvolvimento local em HTTP.
ADMIN_COOKIE_SECURE=true
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=900

# CORS: origens exatas que podem chamar a API pelo navegador com credenciais.
# Vazio = nenhum acesso de navegador. Lista JSON, por exemplo:
# CORS_ORIGINS=["https://admin.example.com"]

